DATABASE_URL="DATABASE_CONNECTION_STRING" # PostgreSQL connection string
NODE_ENV=""                               # Environment: development, production, etc.
PORT=                                     # API server port (Default is 3200)
JWT_SECRET=""                             # Secret used for token/signing operations
AUTH_SESSION_TTL_MS=                      # Session lifetime in milliseconds
ENCRYPTION_KEY=                           # Key used to encrypt sensitive data
TRUST_PROXY=                              # Proxy trust setting: false, 1, 2, loopback, or IP/CIDR
BASTION_BOOTSTRAP_EMAIL=                  # Email for the initial owner account