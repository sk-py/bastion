# ============================================================
# Database
# ============================================================

# Set to "postgres" to run PostgreSQL through Docker.
# Leave empty to use an external PostgreSQL database.
COMPOSE_PROFILES=postgres

# When using Docker PostgreSQL:
DATABASE_URL=postgresql://bastion:bastion_password@postgres:5432/bastion

# PostgreSQL container settings.
# Only used when COMPOSE_PROFILES=postgres.
POSTGRES_DB=bastion
POSTGRES_USER=bastion
POSTGRES_PASSWORD=bastion_password

# ============================================================
# API
# ============================================================

NODE_ENV=""                               # Environment: development, production, etc.
PORT=18400                                # API server port (Default is 3002)

JWT_SECRET=""                             # Secret used for token/signing operations
AUTH_SESSION_TTL_MS=21600000              # Session lifetime in milliseconds (6 hour default)
ENCRYPTION_KEY=                           # Key used to encrypt sensitive data
TRUST_PROXY=loopback                      # Proxy trust setting: false, 1, 2, loopback, or IP/CIDR
BASTION_BOOTSTRAP_EMAIL=                  # Email for the initial owner account